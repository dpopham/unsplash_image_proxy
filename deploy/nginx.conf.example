# Example reverse proxy for the wallpaper server (TLS certificate lines omitted).
limit_req_zone $binary_remote_addr zone=wallpaper:10m rate=30r/m;

server {
    listen 443 ssl;
    http2 on;
    server_name wallpapers.example.com;
    server_tokens off;

    # ssl_certificate     /etc/letsencrypt/live/wallpapers.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/wallpapers.example.com/privkey.pem;

    client_max_body_size 1k;           # GET-only service

    # Keep the liveness probe internal.
    location = /healthz { return 404; }

    location / {
        limit_req zone=wallpaper burst=10 nodelay;

        # Optional access control - pick one if the service should not be public:
        # allow 192.168.0.0/16;
        # deny  all;
        # auth_basic           "Wallpapers";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass         http://127.0.0.1:1962;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
