# Copy to .env and fill in. Never commit the real .env (chmod 600 it).

# Make sure to remove any text, including comments, after any variable.
# i.e.
#    NO   UNSPLASH_ORIENTATION=landscape   # landscape | portrait | squarish
#    YES  UNSPLASH_ORIENTATION=landscape

# --- required -----------------------------------------------------------
ACCESS_KEY=your-unsplash-access-key

# --- general ------------------------------------------------------------
# Public URL of this service; used for the "raw" link in /json/ responses.
# An https:// value also enables the HSTS header.
BASE_URL=http://localhost:1962
# Where cached images live (must be writable by the service user).
# Default: <project>/cache
#CACHE=/var/www/unsplash/cache
#MAX_FILES=500
# Never enable in production (exposes tracebacks).
#DEBUG=false

# --- what to show ---------------------------------------------------------
#UNSPLASH_QUERY=disney
#UNSPLASH_ORIENTATION=landscape   # landscape | portrait | squarish
#DESCRIPTION=Walt Disney World
#IMAGE_WIDTH=1920                 # width requested from the image CDN
#PAGE_REFRESH_SECONDS=30          # 0 = never reload the HTML page

# --- upstream usage / abuse limits -----------------------------------------
#REFRESH_INTERVAL=300             # seconds between background downloads, 0 = off
#RATE_LIMIT=10/minute             # per client IP, HTML + raw image (shared)
#JSON_RATE_LIMIT=60/minute        # per client IP, /json/
#TRACK_DOWNLOADS=true             # report photo use to Unsplash (API guidelines)
